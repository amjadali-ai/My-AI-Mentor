{
  "name": "my-ai-mentor",
  "productName": "My AI Mentor",
  "description": "Personal AI study mentor, university timetable manager, productivity tracker, and self-improvement coach.",
  "author": "AI Mentor Engineer",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:ui": "vite build",
    "build:server": "esbuild server.ts --platform=node --format=esm --outfile=dist-server/server.mjs --packages=external",
    "build:icons": "node scripts/generate-icon.js",
    "build": "npm run build:icons && npm run build:ui && npm run build:server",
    "preview": "tsx server.ts",
    "start": "tsx server.ts",
    "electron:dev": "electron .",
    "electron:build": "npm run build && electron-builder --win --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "clean": "rm -rf dist dist-server release",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
