{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and student information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "degree": { "type": "string", "maxLength": 128 },
        "semester": { "type": "string", "maxLength": 64 },
        "university": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Subject": {
      "title": "Subject",
      "description": "University course enrolled by student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 128 },
        "instructor": { "type": "string", "maxLength": 128 },
        "room": { "type": "string", "maxLength": 64 },
        "creditHours": { "type": "number" },
        "color": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 2048 },
        "targetGrade": { "type": "string", "maxLength": 16 }
      },
      "required": ["id", "userId", "code", "name"]
    },
    "TimetableClass": {
      "title": "TimetableClass",
      "description": "Class session time slot in weekly schedule",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "day": { "type": "string", "maxLength": 16 },
        "startTime": { "type": "string", "maxLength": 8 },
        "endTime": { "type": "string", "maxLength": 8 },
        "room": { "type": "string", "maxLength": 64 },
        "classType": { "type": "string", "maxLength": 32 },
        "isRecurring": { "type": "boolean" }
      },
      "required": ["id", "userId", "subjectId", "day", "startTime", "endTime"]
    },
    "Deadline": {
      "title": "Deadline",
      "description": "Academic assessment deadline or exam",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "type": { "type": "string", "maxLength": 64 },
        "dueDate": { "type": "string", "maxLength": 32 },
        "dueTime": { "type": "string", "maxLength": 16 },
        "weightPercent": { "type": "number" },
        "maxScore": { "type": "number" },
        "obtainedScore": { "type": "number" },
        "status": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 2048 }
      },
      "required": ["id", "userId", "subjectId", "title", "dueDate", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "Student daily task and action item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2048 },
        "category": { "type": "string", "maxLength": 64 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "goalId": { "type": "string", "maxLength": 128 },
        "priority": { "type": "string", "maxLength": 16 },
        "plannedDate": { "type": "string", "maxLength": 32 },
        "plannedTime": { "type": "string", "maxLength": 16 },
        "estimatedMinutes": { "type": "number" },
        "actualMinutes": { "type": "number" },
        "status": { "type": "string", "maxLength": 32 },
        "missedReason": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "status"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Long-term goal and milestone roadmap",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "description": { "type": "string", "maxLength": 2048 },
        "category": { "type": "string", "maxLength": 64 },
        "targetDate": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 32 },
        "notes": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "targetDate", "status"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Recorded study timer session with reflection",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "taskId": { "type": "string", "maxLength": 128 },
        "goalId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "sessionType": { "type": "string", "maxLength": 32 },
        "isMeasured": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "durationMinutes"]
    },
    "DailyReflection": {
      "title": "DailyReflection",
      "description": "Evening reflection entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "wellDone": { "type": "string", "maxLength": 2048 },
        "mistakes": { "type": "string", "maxLength": 2048 },
        "learnedConcept": { "type": "string", "maxLength": 2048 },
        "missedTasksAnalysis": { "type": "string", "maxLength": 2048 },
        "tomorrowImprovement": { "type": "string", "maxLength": 2048 },
        "gratitudeOrPride": { "type": "string", "maxLength": 2048 },
        "energyScore": { "type": "number" },
        "focusScore": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "date"]
    },
    "WeeklyReview": {
      "title": "WeeklyReview",
      "description": "Weekly performance report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "weekStartDate": { "type": "string", "maxLength": 32 },
        "weekEndDate": { "type": "string", "maxLength": 32 },
        "summary": { "type": "string", "maxLength": 4096 },
        "totalStudyMinutes": { "type": "number" },
        "plannedTasksCount": { "type": "number" },
        "completedTasksCount": { "type": "number" },
        "skippedOrPostponedCount": { "type": "number" },
        "aiSynthesized": { "type": "boolean" },
        "studentNotes": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "weekStartDate", "weekEndDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "University courses"
    },
    "/users/{userId}/timetable/{slotId}": {
      "schema": "TimetableClass",
      "description": "Timetable class schedule slots"
    },
    "/users/{userId}/deadlines/{deadlineId}": {
      "schema": "Deadline",
      "description": "Deadlines and assessments"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Student daily tasks"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "Goals and milestones"
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": "StudySession",
      "description": "Study logs"
    },
    "/users/{userId}/reflections/{reflectionId}": {
      "schema": "DailyReflection",
      "description": "Daily evening reflections"
    },
    "/users/{userId}/weeklyReviews/{reviewId}": {
      "schema": "WeeklyReview",
      "description": "Weekly reports"
    }
  }
}
